(
    version: "1.0",
    master_seed: 42,
    bpm: 120.0,
    modules: [
        (
            kind: "clock",
            instance_name: "clock_main",
            parameters: { "bpm": Float(120.0), "ppqn": Int(4), "pulse_width_ms": Int(1) },
            display_name: "",
            description: "",
            tags: [],
        ),
        (
            kind: "turing_machine",
            instance_name: "tm_main",
            parameters: {
                "write_probability": Float(0.5),
                "length": Int(8),
                "scale": Scale((root: 0, intervals: [0, 2, 4, 7, 9], name: Some("Major Pentatonic"))),
                "note_min": Int(48),
                "note_max": Int(72),
            },
            display_name: "",
            description: "",
            tags: [],
        ),
        (
            kind: "lfo",
            instance_name: "lfo_main",
            parameters: {
                "waveform": String("sine"),
                "frequency_hz": Float(0.5),
                "phase_offset": Float(0.0),
                "pulse_width": Float(0.5),
            },
            display_name: "",
            description: "",
            tags: [],
        ),
        (
            kind: "midi_out",
            instance_name: "midi_main",
            parameters: { "channel": Int(0), "noise_cc": Int(-1), "note_cc": Int(-1), "velocity_cc": Int(-1) },
            display_name: "",
            description: "",
            tags: [],
        ),
    ],
    cables: [
        (source: ("clock_main", "pulse"), target: ("tm_main", "clock"), transform: None, display_name: "", description: "", tags: []),
        (source: ("lfo_main", "bipolar_out"), target: ("tm_main", "write_modulation"), transform: Some(Affine(factor: 0.5, offset: 0.0)), display_name: "", description: "", tags: []),
        (source: ("tm_main", "step"), target: ("midi_main", "step"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "note"), target: ("midi_main", "note"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "note_valid"), target: ("midi_main", "note_valid"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "velocity"), target: ("midi_main", "velocity"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "velocity_valid"), target: ("midi_main", "velocity_valid"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "gate"), target: ("midi_main", "gate"), transform: None, display_name: "", description: "", tags: []),
        (source: ("tm_main", "noise_cc"), target: ("midi_main", "noise_cc"), transform: None, display_name: "", description: "", tags: []),
    ],
    rack: None,
)
